{
  "name": "veritasor-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src",
    "perf:k6:attestations": "k6 run ops/k6/peak-attestation.js",
    "perf:k6:black-friday": "k6 run ops/k6/black-friday.js",
    "perf:k6:compare": "tsx scripts/compare-k6.ts --mode compare",
    "perf:k6:save-baseline": "tsx scripts/compare-k6.ts --mode save-baseline",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:rollback": "tsx src/db/migrate.ts rollback",
    "migrate:verify-rollback": "tsx src/db/migrate.ts verify-rollback",
    "migrate:lint-companions": "tsx src/db/migrate.ts lint-companions",
    "docs:routes": "tsx scripts/generate-routes.ts",
    "docs:openapi": "tsx scripts/generate-openapi.ts",
    "sbom:generate": "tsx scripts/generate-sbom.ts",
    "audit:ci": "pnpm audit --prod --json | pnpm exec tsx scripts/check-audit.ts",
    "rebuild:indexer": "tsx scripts/rebuild-indexer.ts",
    "pact:can-i-deploy": "tsx scripts/can-i-deploy.ts",
    "pact:test": "vitest run tests/pact/",
    "pact:publish": "tsx scripts/publish-pact.ts"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^5.6.0",
    "@graphql-tools/schema": "^10.0.38",
    "@graphql-tools/stitch": "^10.2.2",
    "@graphql-tools/utils": "^11.2.2",
    "@graphql-yoga/plugin-persisted-operations": "^3.21.2",
    "@grpc/grpc-js": "^1.13.4",
    "@grpc/proto-loader": "^0.7.15",
    "@openfeature/server-sdk": "^1.22.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.2",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.57.2",
    "@stellar/stellar-sdk": "^14.5.0",
    "bcryptjs": "^2.4.3",
    "commander": "^15.0.0",
    "cors": "^2.8.5",
    "dataloader": "^2.2.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "fzstd": "^0.1.1",
    "graphql": "^17.0.1",
    "graphql-yoga": "^5.21.2",
    "helmet": "^8.3.0",
    "hot-shots": "^17.1.0",
    "ioredis": "5.3.2",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "2.2.4",
    "nodemailer": "^8.0.10",
    "openpgp": "^6.3.1",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "tar-stream": "^3.2.0",
    "tinypool": "^0.8.4",
    "ws": "8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^4.2.1",
    "@jest/globals": "^29.7.0",
    "@pact-foundation/pact": "^13.2.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.16",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.3",
    "@types/tar-stream": "^3.1.4",
    "@types/ws": "8.5.13",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.15.0",
    "fast-check": "^4.6.0",
    "helmet": "^8.3.0",
    "jest": "^30.2.0",
    "license-checker": "^25.0.1",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.1",
    "toxiproxy-node": "^1.0.1",
    "ts-jest": "^29.4.6",
    "tsx": "^4.19.2",
    "typescript": "~5.6.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.10"
  },
  "overrides": {}
}
